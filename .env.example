# Copy this file to .env and fill in the required values.
# Never commit the real .env file.

# --- simulator ---
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused
SIMULATOR_BASE_URL=http://simulator:8000

# --- agent ---
# autopilot | copilot | manual
AGENT_AUTONOMY=copilot
# lp | heuristic
PLANNER_POLICY=lp
PLANNER_HORIZON_TICKS=32
APPROVAL_TTL_TICKS=8
CONFIDENCE_REVIEW_THRESHOLD=0.6

# --- platform ---
OPERATOR_TOKEN=change-me
POSTGRES_USER=fsa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fsa

# --- optional LLM (leave empty to use template explanations) ---
# set LLM_PROVIDER=anthropic and LLM_API_KEY to get LLM explanations (default model claude-opus-5-5)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- misc ---
IMAGE_TAG=latest
LOG_LEVEL=INFO
